{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "link-lumena-id",
  "main": ".open-next/worker.js",
  "account_id": "48dee4823e0fa8e71aabb753cee66139",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://link.lumena.id"
  },
  "routes": [
    {
      "pattern": "link.lumena.id",
      "custom_domain": true
    }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "link-lumena-id"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
