# Salin ke .env.local lalu isi. Jangan commit .env.local.

# Nomor WhatsApp tim kemitraan, format internasional tanpa "+".
# Contoh: 6281116613238  (+62 811-1661-3238)
# Dibaca di server saat request, jadi bisa diganti tanpa build ulang.
# Kalau kosong, halaman terima kasih memakai nomor tim default.
WA_NUMBER=

# Endpoint penerima lead (n8n webhook / CRM).
# Menerima POST JSON { namaDepan, namaBelakang, nama, email, whatsapp, kota, waktu, sumber }.
# Hanya dibaca di server (route handler /api/lead), tidak pernah ikut
# terkirim ke browser. Selama kosong, lead TIDAK tersimpan di mana pun —
# hanya dicatat sebagai warning di log server.
LEAD_ENDPOINT=

# Meta Pixel / Dataset ID. Kalau kosong, tidak ada request pihak ketiga
# sama sekali. Kalau diisi, base code dipasang di semua halaman dan event
# Lead dikirim di halaman terima kasih.
NEXT_PUBLIC_META_PIXEL_ID=
